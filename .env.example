# Copy thành .env.local và điền giá trị thật (KHÔNG commit .env.local)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Gửi email form đặt lịch (src/app/api/contact/route.js) ----------
# Gmail: bật Xác minh 2 bước → tạo "Mật khẩu ứng dụng" (16 ký tự) tại
# https://myaccount.google.com/apppasswords rồi dán vào SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Hộp thư nhận yêu cầu (bỏ trống = gửi về chính SMTP_USER). Nhiều người nhận: cách nhau bằng dấu phẩy.
CONTACT_TO_EMAIL=
# Tên & địa chỉ người gửi hiển thị (bỏ trống = "Studio Bin Website" <SMTP_USER>)
MAIL_FROM=
